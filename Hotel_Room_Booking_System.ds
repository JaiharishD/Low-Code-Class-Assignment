 * Version      : 1.0
 */
 application "Hotel Room Booking System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Hotel_Room_Booking_Form
		{
			displayname = "Hotel Room Booking Form"
			success message = "Data Added Successfully!"
			Guest_Details
			(
				type = section
				displayname = "Guest Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Guest_Name
			(
    			type = name
				displayname = "Guest Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have ID_Proof_Number
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Number_Of_Guests
			(
				type = number
				maxchar = 1
				initial value = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Contact_Details
			(
				type = section
				displayname = "Contact Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			unique Email_Address
			(
    			type = email
				maxchar = 80
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Contact_Number
			(
    			type = phonenumber
    			allowedcountries={in}
    			defaultcountry="in"
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Permanent_Address
			(
    			type = address
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Room_Stay_Preferences
			(
				type = section
				displayname = "Room & Stay Preferences"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			must have Room_Type
			(
				type = picklist
				maxchar = 100
				values = {"AC ROOM","Non AC Room"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Meal_Plan
			(
				type = radiobuttons
				maxchar = 100
				values = {"Yes","No"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Amenities_Required
			(
				type = list	
				values = {"Extra Bed","Airport Pickup","Late Checkout"}
				height = 60px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Special_Requests
			(
    			type = textarea
				height = 100px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Scheduling_Policy_Acknowledgement
			(
				type = section
				displayname = "Scheduling & Policy Acknowledgement"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			must have unique Check_In_Date
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 1   
				width = medium
			)
			Preferred_Checkin_Time
			(
    			type = time
				timedisplayoptions = "hh:mm:ss" 
	 			row = 4
	 			column = 1   
				width = medium
			)
			Number_of_days
			(
				type = number
				displayname = "Number of days"
	 			row = 4
	 			column = 1   
				width = medium
			)
			must have Agree_To_Hotel_Policies
			(
				type = checkboxes	
				values = {"Agree"}
	 			row = 4
	 			column = 1   
				width = medium
			)
			Room_Verification_Identity
			(
				type = section
				displayname = "Room Verification & Identity"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Hotel_Room_Booking_FormRoom_Type_Availability_Lookup
			(
				type = picklist	
				displayname = "Room_Type_Availability_Lookup"
				values  = Hotel_Room_Booking_Form.ID
    			displayformat = [Room_Type]
				sortorder = ascending
	 			row = 5
	 			column = 1   
				width = medium
			)
			Guest_Photo
			(
    			type = image
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 5
	 			column = 1   
				width = medium
			)
			ID_Proof_Upload
			(
    			type = upload file
				browse = local_drive
	 			row = 5
	 			column = 1   
				width = medium
			)
			Distance_From_Airport_KM
			(
				type = decimal
	 			row = 5
	 			column = 1   
				width = medium
			)
			Additional_Guests_Details
			(
				type = grid
				Name
				(
    				type = name
     				prefix
     				(
	     				 type = prefix
	     				 displayname ="Prefix"
	     				 visibility = false
	     				 value = {"Mr.","Mrs.","Ms."}
     				) 
     				first_name
     				(
	     				 type = first_name
	     				 displayname ="First Name"
     				) 
     				last_name
     				(
	     				 type = last_name
	     				 displayname ="Last Name"
	     				 visibility = false
     				) 
     				suffix
     				(
	     				 type = suffix
	     				 displayname ="Suffix"
	     				 visibility = false
     				) 
					width = medium
					personal data = true
				)
				Age
				(
					type = number
					width = medium
				)
				ID_TYPE
				(
    				type = text
					width = medium
				)
	 			row = 6
	 			column = 1   
				width = medium
			)
			Group_Booking_Media_Details
			(
				type = section
				displayname = "Group Booking & Media Details"
				visibility = true
	 			row = 7
	 			column = 0   
				width = medium
			)
			Travel_Itinerary_URL
			(
    			type = url
				enable  linkname
	 			row = 7
	 			column = 1   
				width = medium
			)
			Celebration_Request_Video
			(
    			type = video
    			duration=30
	 			row = 7
	 			column = 1   
				width = medium
			)
			Special_Request_Voice_Note
			(
     			type = audio
    			duration=60
	 			row = 7
	 			column = 1   
				width = medium
			)
			SectionPayment_Pickup_Preference
			(
				type = section
				displayname = "SectionPayment & Pickup Preference"
				visibility = true
	 			row = 8
	 			column = 0   
				width = medium
			)
			Requires_Airport_Pickup
			(
    			type = checkbox
				initial value = false
	 			row = 8
	 			column = 1   
				width = medium
			)
			Formula
			(
				type = decimal
	 			row = 8
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  (1 - input.Loyalty_Discount_Percent) * input.Advance_Payment_Paid
    						visibility = false
    			)
			)
			Advance_Payment_Paid
			(
				type = INR
				format = commadotindian
	 			row = 8
	 			column = 1   
				width = medium
			)
			Loyalty_Discount_Percent
			(
    			type = percentage
	 			row = 8
	 			column = 1   
				width = medium
			)
			Declaration_System_Generated_Values
			(
				type = section
				displayname = "Declaration & System-Generated Values"
				visibility = true
	 			row = 9
	 			column = 0   
				width = medium
			)
			Hotel_Policies_Display
			(
    			type = richtext
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 9
	 			column = 1   
				width = medium
			)
			Guest_Digital_Signature
			(
    			type = signature
	 			row = 9
	 			column = 1   
				width = medium
				personal data = true
			)
			Booking_Submitted_On
			(
    			type = datetime
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 9
	 			column = 1   
				width = medium
			)
			Booking_ID
			(
    			type = autonumber
				start index = 1
	 			row = 9
	 			column = 1   
				width = medium
			)
			QR_Code
			(
				type = qrcode
				displayname = "Booking_Confirmation_QR_Code"
				value = "${Booking_ID}${Check_In_Date}"
	 			row = 9
	 			column = 1   
				width = medium
			)
			Section
			(
				type = section
	 			row = 10
	 			column = 0   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Form Filling","Submit","Enquiry","Confirmed","Rejected","Checked-In","Checked-Out"}
			}
