				}
			}
		}
	}
	reports
	{
		list All_Bookings_List
		{
			displayName = "All_Bookings_List"
			show all rows from Hotel_Room_Booking_Form    
			(
				Guest_Name  as "Guest Name"
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Room_Type
				Check_In_Date
				Booking_Submitted_On
				Hotel_Room_Booking_FormRoom_Type_Availability_Lookup.Contact_Number
				(
					displayformat = plainnumber 
				)
			)
			sort by
			(
				Check_In_Date ascending
			)
		}
		spreadsheet Bookings_Spreadsheet
		{
			displayName = "Bookings_Spreadsheet"
			show all rows from Hotel_Room_Booking_Form    
			(
				Guest_Name  as "Guest Name"
				ID_Proof_Number
				Number_Of_Guests
				Email_Address
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Permanent_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Room_Type
				Meal_Plan
				Amenities_Required
				Special_Requests
				Check_In_Date
				Preferred_Checkin_Time
				Agree_To_Hotel_Policies
				Hotel_Room_Booking_FormRoom_Type_Availability_Lookup as "Room_Type_Availability_Lookup"
				Guest_Photo
				ID_Proof_Upload
				Distance_From_Airport_KM
				Travel_Itinerary_URL
				Celebration_Request_Video
				Special_Request_Voice_Note
				Requires_Airport_Pickup
				Formula
				Advance_Payment_Paid
				Loyalty_Discount_Percent
				Hotel_Policies_Display
				Guest_Digital_Signature
				Booking_Submitted_On
				Booking_ID
				QR_Code as "Booking_Confirmation_QR_Code"
				Hotel_Room_Booking_FormRoom_Type_Availability_Lookup.Check_In_Date
			)
		}
		kanban Booking_Status_Kanban
		{
			displayName = "Booking_Status_Kanban"
			show all rows from Hotel_Room_Booking_Form    
			(
				Guest_Name  as "Guest Name"
				ID_Proof_Number
				Number_Of_Guests
				Email_Address
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Permanent_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Room_Type
				Meal_Plan
				Amenities_Required
				Special_Requests
				Check_In_Date
				Preferred_Checkin_Time
				Agree_To_Hotel_Policies
				Hotel_Room_Booking_FormRoom_Type_Availability_Lookup as "Room_Type_Availability_Lookup"
				Guest_Photo
				ID_Proof_Upload
				Distance_From_Airport_KM
				Travel_Itinerary_URL
				Celebration_Request_Video
				Special_Request_Voice_Note
				Requires_Airport_Pickup
				Formula
				Advance_Payment_Paid
				Loyalty_Discount_Percent
				Hotel_Policies_Display
				Guest_Digital_Signature
				Booking_Submitted_On
				Booking_ID
				QR_Code as "Booking_Confirmation_QR_Code"
			)
			options
			(
	 			display field = Room_Type
	 		)
		}
		calendar Booking_Status_Kanban1
		{
			displayName = "Booking_Status_Kanban"
			show all rows from Hotel_Room_Booking_Form    
			(
				Guest_Name  as "Guest Name"
				ID_Proof_Number
				Number_Of_Guests
				Email_Address
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Permanent_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Room_Type
				Meal_Plan
				Amenities_Required
				Special_Requests
				Check_In_Date
				Preferred_Checkin_Time
				Agree_To_Hotel_Policies
				Hotel_Room_Booking_FormRoom_Type_Availability_Lookup as "Room_Type_Availability_Lookup"
				Guest_Photo
				ID_Proof_Upload
				Distance_From_Airport_KM
				Travel_Itinerary_URL
				Celebration_Request_Video
				Special_Request_Voice_Note
				Requires_Airport_Pickup
				Formula
				Advance_Payment_Paid
				Loyalty_Discount_Percent
				Hotel_Policies_Display
				Guest_Digital_Signature
				Booking_Submitted_On
				Booking_ID
				QR_Code as "Booking_Confirmation_QR_Code"
			)
			options
			(
				display field = Guest_Name
				start date = Check_In_Date
			)
		}
	}
