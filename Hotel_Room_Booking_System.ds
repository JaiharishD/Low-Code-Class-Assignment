		workflow
		{
		form
		{
			Send_Email_Form_Propertie as "Send Email - Form Properties"
			{
				type =  presuccess
				form = Hotel_Room_Booking_Form
				on start
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : Email_Address
							subject : "Hotel Room Booking System : Hotel Booked Successfully!!"
							message : "<div>Hello ${Guest_Name},<br><br>Your Hotel has been Booked on&nbsp;${Check_In_Date} for ${Number_Of_Guests}.</div>"
						)
					}
				}
			}
			Email_trigger as "Email trigger"
			{
				type =  form
				form = Hotel_Room_Booking_Form

				record event = on add or edit
					status = inactive

				on success
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : Email_Address
							subject : "Hotel Booked Successfully!!"
							message : "<div><span style=\"background-color:rgb(255, 255, 255)\" class=\"highlight\"><span style=\"color:rgb(34, 34, 34)\" class=\"colour\"><span style=\"font-family:Arial, Helvetica, sans-serif\" class=\"font\"><span style=\"font-size: small; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none;\" class=\"size\">Hello ${Guest_Name},</span></span></span></span><br></div><div><br></div><div><span style=\"background-color:rgb(255, 255, 255)\" class=\"highlight\"><span style=\"color:rgb(34, 34, 34)\" class=\"colour\"><span style=\"font-family:Arial, Helvetica, sans-serif\" class=\"font\"><span style=\"font-size: small; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none;\" class=\"size\">Your Hotel has been Booked on&nbsp;${Check_In_Date} for ${Number_of_days} days.</span></span></span></span><br></div>"
						)
					}
				}

			}
		}

		schedule
		{
			Daily_Checkin_Reminder_Sc as "Daily_Checkin_Reminder_Schedule"
			{
				type =  schedule
				form = Hotel_Room_Booking_Form
					status = inactive
				start = before 365 days from Check_In_Date at "18:00:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : Email_Address
							subject : "Remainder to Check IN!!"
							message : "<div><span style=\"color: rgb(34, 34, 34); font-family: Arial, Helvetica, sans-serif; font-size: small; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;\">Hello ${Guest_Name},</span><br></div><div><br></div><div><span style=\"color: rgb(34, 34, 34); font-family: Arial, Helvetica, sans-serif; font-size: small; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;\">Your Hotel has been Booked on&nbsp;27-Aug-2026 for ${Number_of_days} days, so please do check in!!</span><br></div>"
						)
					}
				}
			}
		}

		approval
		{
			Complimentary_Upgrade_App as "Complimentary_Upgrade_Approval"
			{
				type =  approval
				form = Hotel_Room_Booking_Form[Loyalty_Discount_Percent > 30]
				display fields = [Guest_Name,ID_Proof_Number,Number_Of_Guests,Email_Address,Contact_Number,Permanent_Address,Room_Type]
				on start
				{
				}
				on level 1
				{
					on approve 
					{
						actions 
						{
							sendmail
							(
								from : "zoho.loginuserid"
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been approved."
							)
						}
					}
					on reject
					{

						actions 
						{
							sendmail
							(
								from : "zoho.loginuserid"
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been rejected."
							)
						}
					}
				}
			}
		}

